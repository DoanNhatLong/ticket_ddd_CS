          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"trainbooking-api\", http_route!=\"/metrics\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"trainbooking-api\", http_route!=\"/metrics\"}[$__rate_interval]))",
