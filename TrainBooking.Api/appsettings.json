{
  
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Instance": {
    "Name": "api-1"
  },
  "FileLogging": {
    "Path": "../logs/trainbooking-.json",
    "FileSizeLimitMb": 10,
    "RetainedFiles": 7
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6380,abortConnect=false"
  },
  "Database": {
    "ServerVersion": "8.0.46-mysql"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "TrainTripIndex": "train-trips",
    "StationIndex": "stations"
  }
}
